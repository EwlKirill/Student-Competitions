# Build context for the application image: only `pyproject.toml`, `uv.lock`, `app/`,
# `alembic.ini` and `migrations/` are needed. Everything below is excluded so the context stays
# small and, above all, so no secret, virtualenv, local database or VCS metadata can reach a
# published image (FR-027).
# See specs/002-public-deploy-cicd/contracts/container.md and
# specs/003-database-questions/contracts/pipeline.md.

# Version control
.git/
.gitignore
.gitattributes

# Environments and secrets — nothing environment-specific belongs in an image
.venv/
.env
.env.*

# A developer's local database — never baked into an image (specs/003-database-questions/
# contracts/pipeline.md)
data/
*.sqlite3
*.db

# Tests, specs and documentation — not shipped to production
tests/
specs/
docs/
.github/
scripts/
.specify/
.claude/
README.md

# Caches and build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# The image itself
Dockerfile
.dockerignore
